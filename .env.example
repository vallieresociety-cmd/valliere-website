# ── VALLIÈRE • Application email delivery (Resend) ──────────────────────────
# Copy this file to `.env.local` for local dev, and set the same keys in
# Netlify → Site configuration → Environment variables for production.

# Required. Create a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender identity. Until you verify a domain in Resend, keep the sandbox
# sender below (it can only deliver to the Resend account owner's address).
# After verifying vallieresociety.com, switch to e.g.:
#   RESEND_FROM=Vallière Society <noreply@vallieresociety.com>
RESEND_FROM=Vallière Society <onboarding@resend.dev>

# Where internal application notifications are delivered.
APPLY_NOTIFY_TO=vallieresociety@gmail.com
