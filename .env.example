# ── VALLIÈRE • Application email delivery (Resend) ──────────────────────────
# Copy this file to `.env.local` for local dev, and set the same keys in
# Netlify → Site configuration → Environment variables for production.

# Required. Create a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender identity. Verify vallieresociety.org in Resend (Domains → add DNS
# records), then this address delivers to any recipient. Before the domain is
# verified you can temporarily use the sandbox sender
# "Vallière Society <onboarding@resend.dev>" (delivers only to your own inbox).
RESEND_FROM=Vallière Society <apply@vallieresociety.org>

# Where internal application notifications are delivered (visible support inbox).
APPLY_NOTIFY_TO=vallieresociety@gmail.com
